# ==============================================================================
# Grainfolio-Web — Supabase Environment Variables
# ==============================================================================
# Copy this file to .env.local and fill in the values for your target environment.
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  ENVIRONMENT A: Cloud Supabase (Staging / Production)                    │
# │  Source: Supabase Dashboard → Project Settings → API                     │
# │                                                                          │
# │  VITE_SUPABASE_URL=https://<project-id>.supabase.co                      │
# │  VITE_SUPABASE_ANON_KEY=sb_publishable_<...>                             │
# │    ↑ Cloud anon keys start with "sb_publishable_"                        │
# └──────────────────────────────────────────────────────────────────────────┘
#
# ┌──────────────────────────────────────────────────────────────────────────┐
# │  ENVIRONMENT B: Local Supabase (Docker + supabase CLI)                   │
# │  Run `supabase start` then copy the values from the CLI output.          │
# │                                                                          │
# │  VITE_SUPABASE_URL=http://127.0.0.1:54321                                │
# │  VITE_SUPABASE_ANON_KEY=eyJ<...>                                         │
# │    ↑ Local anon keys are raw JWT strings starting with "eyJ"             │
# │      Do NOT paste a cloud "sb_publishable_..." key here —                │
# │      it will be rejected by the local Supabase instance.                 │
# └──────────────────────────────────────────────────────────────────────────┘
#
# Optional: restrict admin access by email (comma-separated).
# Users whose emails match will receive the 'admin' role on sign-in.
# VITE_ADMIN_EMAILS=admin@grainfolio.com

# Optional: support inbox used by the local/manual VIP upgrade flow.
# If omitted, the UI falls back to grainfolio@example.com.
# VITE_SUPPORT_EMAIL=support@grainfolio.com

# Local-first default: keep Supabase push/pull/realtime disabled until you are
# ready to connect a valid local or cloud Supabase project.
VITE_ENABLE_SUPABASE_SYNC=false

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
